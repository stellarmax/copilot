# Copy this file to deploy.env (which is git-ignored) and fill in both values.
# Find them in the Cloudflare Zero Trust dashboard; see docs/DEPLOY_CLOUDFLARE_ZH.md.

# Your Zero Trust team domain, e.g. myteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com

# "Application Audience (AUD) Tag" of the Access application protecting your hostname
CF_ACCESS_AUD=paste-the-aud-tag-here
