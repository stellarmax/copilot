# Copy this file to deploy.env (which is git-ignored) and fill it in.
# See docs/DEPLOY_CLOUDFLARE_ZH.md.

# Required. People need this code to create an account. At least 8 characters; share it only with your team.
COPILOT_INVITE_CODE=choose-a-long-team-code

# Optional second gate: Cloudflare Access (e-mail one-time PIN in front of the site).
# Leave both empty to rely on the app's own accounts only.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
